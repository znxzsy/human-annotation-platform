# Local paths
ANNOTATION_DB=runtime/review.sqlite3
ANNOTATION_AUDIT=runtime/audit.jsonl
ANNOTATION_EXPORTS=runtime/exports

# Set to 1 in shared deployments. The local demo leaves it at 0.
ANNOTATION_AUTH_REQUIRED=0
ANNOTATION_SESSION_SECRET_FILE=secrets/session-secret
ANNOTATION_SESSION_TTL=604800
ANNOTATION_COOKIE_PATH=/
ANNOTATION_COOKIE_SECURE=0

# Optional local display name when authentication is disabled.
ANNOTATION_DEMO_REVIEWER=演示标注员
